{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexyfab.com/schemas/mechanical-design-adapter-approval.v1.json",
  "title": "NexyFab mechanical design adapter approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseChannel",
    "evidenceRootId",
    "adapter",
    "approval",
    "claimBoundary"
  ],
  "properties": {
    "schema": { "const": "nexyfab.mechanical-design-adapter-approval.v1" },
    "releaseChannel": { "const": "mechanical-core" },
    "evidenceRootId": { "$ref": "#/$defs/sha256" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "version"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approverId", "role", "algorithm", "approvedAt", "expiresAt", "signature"],
      "properties": {
        "approverId": { "type": "string", "minLength": 1 },
        "role": { "const": "mechanical-adapter-release-approver" },
        "algorithm": { "const": "Ed25519" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "minLength": 88, "maxLength": 88 }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["importsOnlyApprovedBytes", "grantsCommercialRelease"],
      "properties": {
        "importsOnlyApprovedBytes": { "const": true },
        "grantsCommercialRelease": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
