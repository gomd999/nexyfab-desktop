#!/usr/bin/env sh
# NexyFab pre-commit gate — keeps the working tree from drifting into a state
# that breaks CI silently. Four concerns, ordered cheapest → most expensive:
#
#   0. size gate: refuse commits >800 lines or >15 files (unless ALLOW_BIG=1)
#   1. lint-staged: eslint --fix on staged files (mutates the file, restages)
#   2. typecheck: full project tsc --noEmit (~20-40s) — catches type drift that
#      a per-file lint can't see (e.g. a renamed export breaking a far file)
#   3. vitest related --run on staged files — runs only the tests that import
#      one of the staged paths, transitively. Skips if no tests are related.
#      Covers .ts/.tsx AND .mjs/.cjs — the drawing-to-3d engine is all .mjs and
#      was silently exempt from this gate until 260728.
#
# To bypass for a known-safe WIP commit: `git commit --no-verify` (avoid; the
# hook exists because every "I'll fix it after I push" has a track record).
# For a knowingly large commit (generated code, lockfile bump): prefix with
# `ALLOW_BIG=1 git commit ...` — the next commit body should explain why.

set -e

# ─── 0. Size gate ───────────────────────────────────────────────────────────
# Block mega-commits. Per docs/process/commit-policy.md: split big work into
# meaningful units. Override via ALLOW_BIG=1 for generated code etc.
if [ -z "${ALLOW_BIG:-}" ]; then
  STAGED_FILES=$(git diff --cached --name-only | wc -l)
  STAGED_LINES=$(git diff --cached --shortstat 2>/dev/null | awk '{print $4+$6}')
  STAGED_LINES=${STAGED_LINES:-0}
  if [ "$STAGED_FILES" -gt 15 ]; then
    echo "✖ commit blocked: $STAGED_FILES files staged (limit 15)"
    echo "  Split into smaller logical units — see docs/process/commit-policy.md"
    echo "  Override (with reason in next commit body): ALLOW_BIG=1 git commit ..."
    exit 1
  fi
  if [ "$STAGED_LINES" -gt 800 ]; then
    echo "✖ commit blocked: $STAGED_LINES lines staged (limit 800)"
    echo "  Split into smaller logical units — see docs/process/commit-policy.md"
    echo "  Override (with reason in next commit body): ALLOW_BIG=1 git commit ..."
    exit 1
  fi
fi

npx lint-staged

echo "→ typecheck (project-wide tsc)..."
npm run typecheck --silent

# Vitest related only runs against the files git just staged. Use the diff
# against HEAD because lint-staged may have restaged after auto-fix.
# .mjs/.cjs 포함(260728): 종전엔 .ts/.tsx 만 봤다. 그런데 소비자 문서를 실제로 만드는
# 엔진(scripts/drawing-to-3d/*.mjs — assembly·package·execution-gate·easy-summary·
# domain-dossier-verify·dxf-export…)은 전부 .mjs 라, 그 파일들을 고쳐도 이 게이트가
# **테스트를 한 줄도 돌리지 않았다**("no source files staged" 로 조용히 통과). 같은 날
# 발견한 shebang 파싱 문제와 겹쳐, MCP 산출물 결함들이 오래 살아남은 이유의 절반이다.
# 실측 비용: 가장 넓은 허브 assembly.mjs 스테이징 시 16파일 211테스트 ~35s (tsc 와 동급).
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(ts|tsx|mjs|cjs)$' \
  | grep -v -E '\.(test|spec)\.(ts|tsx|mjs|cjs)$' \
  || true)

if [ -n "$STAGED_SRC" ]; then
  echo "→ vitest related to staged sources..."
  echo "$STAGED_SRC" | xargs npx vitest related --run --reporter=default
else
  echo "→ no source files staged; skipping vitest related."
fi
