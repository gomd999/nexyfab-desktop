{
  "schema": "nexyfab.deployable-unit.v1",
  "id": "core-api",
  "kind": "application",
  "targetRuntime": "railway-node",
  "sourceMode": "legacy-route-compatibility",
  "legacySource": ["src/app/api", "src/lib/db-adapter.ts"],
  "implementationState": "COMPATIBILITY_BOUNDARY",
  "deployEnabled": false,
  "rollbackOwner": "legacy-next-origin",
  "build": { "context": ".", "dockerfile": "Dockerfile", "mode": "shared-monorepo-compatibility" },
  "health": { "live": "/api/health/live", "ready": "/api/health/ready", "timeoutSeconds": 30 },
  "staging": { "required": true, "evidencePath": "docs/evidence/platform-runtime/slice-deployment-readiness.json" },
  "rollback": { "strategy": "previous-release", "verifyCommand": "npm run rollback:verify", "requiredBuildBinding": true }
}
