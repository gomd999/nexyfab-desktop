{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexyfab.com/schemas/holdout-acquisition-receipts-v1.schema.json",
  "title": "NexyFab holdout acquisition control receipts v1",
  "oneOf": [
    { "$ref": "#/$defs/modelFreeze" },
    { "$ref": "#/$defs/isolation" },
    { "$ref": "#/$defs/nativeStructure" },
    { "$ref": "#/$defs/archiveManifest" },
    { "$ref": "#/$defs/reviewAttestation" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "identity": {
      "type": "object",
      "required": ["slotId", "family", "sourceHash"],
      "properties": {
        "slotId": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "sourceHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "modelFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "releaseHead", "frozenAt", "queueSha256", "existingCasesSha256", "signatureVerification"],
      "properties": {
        "schema": { "const": "nexyfab.model-freeze-receipt.v1" },
        "releaseHead": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
        "frozenAt": { "type": "string", "format": "date-time" },
        "queueSha256": { "$ref": "#/$defs/sha256" },
        "existingCasesSha256": { "$ref": "#/$defs/sha256" },
        "signatureVerification": { "$ref": "#/$defs/signatureVerification" }
      }
    },
    "isolation": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "slotId", "family", "sourceHash", "effectiveAt", "accessPolicyId", "controls"],
          "properties": {
            "schema": { "const": "nexyfab.holdout-isolation-receipt.v1" },
            "slotId": true,
            "family": true,
            "sourceHash": true,
            "effectiveAt": { "type": "string", "format": "date-time" },
            "accessPolicyId": { "type": "string", "minLength": 1 },
            "controls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "excludedFromTraining", "excludedFromFineTuning",
                "excludedFromPromptDevelopment", "evaluationAccessRestricted"
              ],
              "properties": {
                "excludedFromTraining": { "const": true },
                "excludedFromFineTuning": { "const": true },
                "excludedFromPromptDevelopment": { "const": true },
                "evaluationAccessRestricted": { "const": true }
              }
            }
          }
        }
      ]
    },
    "nativeStructure": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "slotId", "family", "sourceHash", "generatedAt", "extractor", "counts"],
          "properties": {
            "schema": { "const": "nexyfab.native-structure-receipt.v1" },
            "slotId": true,
            "family": true,
            "sourceHash": true,
            "generatedAt": { "type": "string", "format": "date-time" },
            "extractor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "artifactHash"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "artifactHash": { "$ref": "#/$defs/sha256" }
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["definitions", "occurrences", "transforms", "joints"],
              "properties": {
                "definitions": { "type": "integer", "minimum": 1 },
                "occurrences": { "type": "integer", "minimum": 1 },
                "transforms": { "type": "integer", "minimum": 1 },
                "joints": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "archiveManifest": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "slotId", "family", "sourceHash", "generatedAt", "scanner", "expandedBytes", "entries"],
          "properties": {
            "schema": { "const": "nexyfab.holdout-archive-manifest.v1" },
            "slotId": true,
            "family": true,
            "sourceHash": true,
            "generatedAt": { "type": "string", "format": "date-time" },
            "scanner": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "artifactHash"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "artifactHash": { "$ref": "#/$defs/sha256" }
              }
            },
            "expandedBytes": { "type": "integer", "minimum": 0 },
            "entries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["relativePath", "kind", "encrypted", "bytes", "sha256"],
                "properties": {
                  "relativePath": { "type": "string", "minLength": 1 },
                  "kind": { "const": "file" },
                  "encrypted": { "const": false },
                  "bytes": { "type": "integer", "minimum": 0 },
                  "sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        }
      ]
    },
    "reviewAttestation": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "kind", "slotId", "family", "sourceHash", "subjectHash",
            "decision", "reviewerId", "reviewedAt", "signatureVerification"
          ],
          "properties": {
            "schema": { "const": "nexyfab.holdout-review-attestation.v1" },
            "kind": { "enum": ["provenance", "holdout_isolation", "native_structure", "conditional_format"] },
            "slotId": true,
            "family": true,
            "sourceHash": true,
            "subjectHash": { "$ref": "#/$defs/sha256" },
            "decision": { "const": "approved" },
            "reviewerId": { "type": "string", "minLength": 1 },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "signatureVerification": { "$ref": "#/$defs/signatureVerification" }
          }
        }
      ]
    },
    "signatureVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "algorithm", "keyId", "verifiedAt", "receiptHash"],
      "properties": {
        "status": { "const": "verified" },
        "algorithm": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "receiptHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
