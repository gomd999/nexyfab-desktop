{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexyfab.com/schemas/independent-domain-review-kit.v3.json",
  "title": "NexyFab cryptographically signed independent domain review kit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "releaseChannel", "requiredDomains", "policy", "summary", "cases"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerId", "independentFromBuild", "decision", "reviewedAt", "targetHash", "signature"],
      "properties": {
        "reviewerId": { "type": "string", "minLength": 1 },
        "independentFromBuild": { "const": true },
        "decision": { "const": "approved" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "targetHash": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schema": { "const": "nexyfab.independent-domain-review-kit.v3" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "releaseChannel": { "enum": ["mechanical-core", "complex-mechanical", "spatial-labs", "platform"] },
    "requiredDomains": { "type": "array", "minItems": 1, "uniqueItems": true },
    "policy": { "type": "object" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredCases", "acquiredCases", "approvedCases", "requiredSignedReviews", "completedSignedReviews"],
      "properties": {
        "requiredCases": { "type": "integer", "minimum": 20 },
        "acquiredCases": { "type": "integer", "minimum": 0 },
        "approvedCases": { "type": "integer", "minimum": 0 },
        "requiredSignedReviews": { "type": "integer", "minimum": 40 },
        "completedSignedReviews": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "domain", "status", "requiredAxes", "source", "blindedRun", "reviews", "releaseEligible"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "domain": { "enum": ["mechanical", "building", "civil", "landscape", "interior"] },
          "status": { "const": "approved" },
          "requiredAxes": { "type": "array", "minItems": 1, "uniqueItems": true },
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["organizationId", "lineageId", "sourceSha256", "licenseDecision", "independentOfTrainingAndReferenceCorpus", "acquisitionAttestation"],
            "properties": {
              "organizationId": { "type": "string", "minLength": 1 }, "lineageId": { "type": "string", "minLength": 1 },
              "sourceSha256": { "$ref": "#/$defs/sha256" }, "licenseDecision": { "const": "approved" },
              "independentOfTrainingAndReferenceCorpus": { "const": true }, "acquisitionAttestation": { "type": "string", "minLength": 1 }
            }
          },
          "blindedRun": {
            "type": "object", "additionalProperties": false,
            "required": ["inputSha256", "outputArtifactHashes", "automaticValidationReceipt", "executedAt"],
            "properties": {
              "inputSha256": { "$ref": "#/$defs/sha256" },
              "outputArtifactHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } },
              "automaticValidationReceipt": { "type": "string", "minLength": 1 }, "executedAt": { "type": "string", "format": "date-time" }
            }
          },
          "reviews": {
            "type": "object", "additionalProperties": false, "required": ["domainReviewer", "independentReviewer", "disagreementResolution"],
            "properties": { "domainReviewer": { "$ref": "#/$defs/review" }, "independentReviewer": { "$ref": "#/$defs/review" }, "disagreementResolution": { "type": ["null", "string"] } }
          },
          "releaseEligible": { "const": true }
        }
      }
    }
  }
}
