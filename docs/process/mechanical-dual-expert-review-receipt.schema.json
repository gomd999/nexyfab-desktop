{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexyfab.com/schemas/mechanical-dual-expert-review.v2.json",
  "title": "NexyFab mechanical-core independent dual expert review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseChannel", "generatedAt", "ok", "reviewKitSchema", "holdoutCorpusSha256", "reviewers", "summary"],
  "properties": {
    "schema": { "const": "nexyfab.mechanical-dual-expert-review.v2" },
    "releaseChannel": { "const": "mechanical-core" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "ok": { "type": "boolean" },
    "reviewKitSchema": { "const": "nexyfab.independent-domain-review-kit.v3" },
    "holdoutCorpusSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewerId", "independentFromBuild", "signedAt", "signatureRef"],
        "properties": {
          "reviewerId": { "type": "string", "minLength": 1 },
          "independentFromBuild": { "const": true },
          "signedAt": { "type": "string", "format": "date-time" },
          "signatureRef": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "dualApproved", "pending", "rejected", "changesRequested"],
      "properties": {
        "cases": { "type": "integer", "minimum": 20 },
        "dualApproved": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "changesRequested": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
