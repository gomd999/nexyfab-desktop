{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexyfab.com/schemas/mechanical-product-scope-assessment.v4.json",
  "title": "NexyFab mechanical-core product scope assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseChannel", "assessedAt", "sources", "evidence", "decision", "blockers", "claimBoundary"],
  "properties": {
    "schema": { "const": "nexyfab.mechanical-product-scope-assessment.v4" },
    "releaseChannel": { "const": "mechanical-core" },
    "assessedAt": { "type": ["string", "null"], "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "canonicalization"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "canonicalization": { "enum": ["utf8-crlf-to-lf", "raw"] }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internalRegressionVerified",
        "intentQualification150Verified",
        "intentRuntimeRepresentativeVerified",
        "assemblyDrawingHandoffLocalVerified",
        "coreThirtyFeatureClosedLoopVerified",
        "directDesignCandidateVerified",
        "directDesignThirtyVerified",
        "intentCampaign150Verified",
        "standardStepConformanceVerified",
        "artifactRevisionConsistencyVerified",
        "blindProductChallengeVerified",
        "manufacturingReceiptVerified"
      ],
      "properties": {
        "internalRegressionVerified": { "type": "boolean" },
        "intentQualification150Verified": { "type": "boolean" },
        "intentRuntimeRepresentativeVerified": { "type": "boolean" },
        "assemblyDrawingHandoffLocalVerified": { "type": "boolean" },
        "coreThirtyFeatureClosedLoopVerified": { "type": "boolean" },
        "directDesignCandidateVerified": { "type": "boolean" },
        "directDesignThirtyVerified": { "type": "boolean" },
        "intentCampaign150Verified": { "type": "boolean" },
        "standardStepConformanceVerified": { "type": "boolean" },
        "artifactRevisionConsistencyVerified": { "type": "boolean" },
        "blindProductChallengeVerified": { "type": "boolean" },
        "manufacturingReceiptVerified": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privateBetaEligible", "selfServiceEligible", "manufacturingReleaseVerified", "failClosed", "status"],
      "properties": {
        "privateBetaEligible": { "type": "boolean" },
        "selfServiceEligible": { "type": "boolean" },
        "manufacturingReleaseVerified": { "type": "boolean" },
        "failClosed": { "const": true },
        "status": {
          "enum": ["private_beta_evidence_pending", "ga_evidence_pending", "self_service_verified", "manufacturing_release_verified"]
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internalRegressionCertifiesCommercialAccuracy",
        "syntheticEvidenceCertifiesCommercialAccuracy",
        "stepExportAloneCertifiesManufacturability",
        "kernelSelfRoundtripCertifiesCommercialCadCompatibility",
        "featureRegistrationAloneCertifiesClosedLoop",
        "spatialLabsEvidenceMaySatisfyMechanicalCore",
        "vendorSpecificCadValidationRequiredForBaseRelease",
        "internalRoleSeparatedReviewMayBeMarketedAsExternal"
      ],
      "properties": {
        "internalRegressionCertifiesCommercialAccuracy": { "const": false },
        "syntheticEvidenceCertifiesCommercialAccuracy": { "const": false },
        "stepExportAloneCertifiesManufacturability": { "const": false },
        "kernelSelfRoundtripCertifiesCommercialCadCompatibility": { "const": false },
        "featureRegistrationAloneCertifiesClosedLoop": { "const": false },
        "spatialLabsEvidenceMaySatisfyMechanicalCore": { "const": false },
        "vendorSpecificCadValidationRequiredForBaseRelease": { "const": false },
        "internalRoleSeparatedReviewMayBeMarketedAsExternal": { "const": false }
      }
    }
  }
}
