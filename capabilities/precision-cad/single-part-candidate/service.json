{
  "schema": "nexyfab.deployable-unit.v1",
  "id": "precision-single-part-candidate",
  "scope": "precision-cad",
  "kind": "worker",
  "targetRuntime": "railway-container",
  "sourceMode": "compatibility-adapter",
  "sourceRoot": "capabilities/precision-cad/single-part-candidate",
  "legacySource": ["src/lib/cad/mechanicalSinglePartCandidate.ts", "scripts/build-mechanical-single-part-candidates.ts"],
  "implementationState": "PARTIAL",
  "verificationState": "NOT_RUN",
  "deployEnabled": false,
  "build": {
    "context": "capabilities/precision-cad/single-part-candidate",
    "dockerfile": "Dockerfile",
    "mode": "isolated-candidate"
  },
  "health": {
    "mode": "http-and-contract",
    "live": "/health/live",
    "ready": "/health/ready",
    "release": "/health/release",
    "test": "capabilities/precision-cad/single-part-candidate/test/server.test.mjs"
  },
  "dependencyProbe": {
    "mode": "active-by-default",
    "timeoutEnv": "NEXYFAB_DEPENDENCY_PROBE_TIMEOUT_MS",
    "targets": [
      { "binding": "EXACT_KERNEL_URL", "path": "/healthz", "expectedService": "exact-cad-kernel", "identityBinding": "EXACT_KERNEL_IDENTITY" },
      { "binding": "JOB_CONTROL_URL", "path": "/healthz", "expectedService": "job-control" }
    ]
  },
  "runtimeBindings": ["EXACT_KERNEL_URL", "EXACT_KERNEL_AUTH_TOKEN", "JOB_CONTROL_URL", "JOB_CONTROL_AUTH_TOKEN", "EXACT_KERNEL_IDENTITY", "NEXYFAB_BUILD_ID"],
  "staging": { "required": true, "evidencePath": "docs/evidence/platform-runtime/slice-deployment-readiness.json" },
  "rollback": { "strategy": "previous-release", "owner": "exact-cad-job-blocked", "requiredBuildBinding": true }
}
