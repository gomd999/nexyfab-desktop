# ════════════════════════════════════════════════════════════════════════════
# NexyFab 환경변수 템플릿 — 이 파일을 .env.local로 복사 후 실제 값으로 교체
# 절대 실제 시크릿을 이 파일에 입력하지 마세요
# ════════════════════════════════════════════════════════════════════════════

# ── 앱 URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nexyfab.com
NEXT_PUBLIC_SITE_URL=https://nexyfab.com
# SSO/Auth server (Cloudflare Workers) — login/register/reset 리다이렉트 베이스
NEXT_PUBLIC_AUTH_URL=https://auth.nexysys.com
# 상위 Nexysys 포털 (헤더/푸터 링크, forgot-password 등)
NEXT_PUBLIC_NEXYSYS_URL=https://nexysys.com
# 한국어(/kr) 푸터의 「통합 사업자·법적 고지」 링크 목적지 (미설정 시 {NEXYSYS_URL}/kr/ )
# NEXT_PUBLIC_NEXYSYS_LEGAL_URL=https://nexysys.com/kr/legal

# 고객 문의 이메일 — 푸터 mailto·환불 안내 페이지 (미설정 시 nexyfab@nexysys.com)
# NEXT_PUBLIC_SUPPORT_EMAIL=nexyfab@nexysys.com

# ── 필수 보안 ───────────────────────────────────────────────────────────────
# 최소 32자 랜덤: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
# bcrypt 해시: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
ADMIN_SECRET=CHANGE_ME_MIN_16_CHARS

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<USERNAME>:<PASSWORD>@<HOST>:5432/nexyfab?sslmode=require

# ── Redis (프로덕션 필수) ────────────────────────────────────────────────────
REDIS_URL=rediss://<USERNAME>:<PASSWORD>@<HOST>:<PORT>

# ── 이메일 발송 (Resend 권장, 또는 SMTP) ─────────────────────────────────────
# 방법 1: Resend (https://resend.com) — RESEND_API_KEY만 설정하면 즉시 동작
RESEND_API_KEY=re_CHANGE_ME

# 방법 2: SMTP 직접 연결 (Resend 없을 때 폴백)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nexyfab@nexysys.com
SMTP_PASS=CHANGE_ME

# NexyFab 공식 발신 주소 — 모든 이메일이 이 주소로 발송됨
SMTP_FROM="NexyFab" <nexyfab@nexysys.com>
NEXYFAB_FROM_EMAIL=nexyfab@nexysys.com

# 관리자 수신 주소
ADMIN_EMAIL=nexyfab@nexysys.com
NEXYFAB_ADMIN_EMAIL=nexyfab@nexysys.com
# 주문/문의 알림 수신자 (콤마 구분)
SEND_MAIL_RECIPIENTS=nexyfab@nexysys.com

# ── Stripe (글로벌 결제 — 카드) ──────────────────────────────────────────────
# Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
# Stripe Dashboard → Developers → Webhooks → 엔드포인트 → Signing secret
# 웹훅 URL: https://nexyfab.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Airwallex (글로벌 결제) ───────────────────────────────────────────────────
AIRWALLEX_CLIENT_ID=CHANGE_ME
AIRWALLEX_API_KEY=CHANGE_ME
AIRWALLEX_WEBHOOK_SECRET=CHANGE_ME
# 환경: "prod" = 운영, 그 외 = sandbox (demo)
AIRWALLEX_ENV=demo
# 국가별 기본 결제수단 오버라이드 (콤마 구분 awMethod 코드, 선택)
# AIRWALLEX_DEFAULT_PM=card,wechatpay
# 플랜별 Airwallex 가격 오버라이드 (USD 기준, 미설정 시 country-pricing.ts 기본값 사용)
# AIRWALLEX_PLAN_PRO_USD=29
# AIRWALLEX_PLAN_TEAM_USD=79
# AIRWALLEX_PLAN_ENTERPRISE_USD=299

# ── Toss Payments ────────────────────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=CHANGE_ME
TOSS_SECRET_KEY=CHANGE_ME
# 웹훅 서명 검증용 (Toss Payments 대시보드 → 웹훅 → 서명 키) — 미설정 시 웹훅 거부
TOSS_WEBHOOK_SECRET=CHANGE_ME

# ── Phase-1 Launch Gates (fake-door) ─────────────────────────────────────────
# 자동 에스크로 결제 흐름 게이트. 통신판매중개업 신고 + Toss 에스크로 옵션 활성
# 완료 후 'true'로 전환. false면 결제 시도 시 '예약' 상태로 잡고 founder 알림.
NEXYFAB_ESCROW_ENABLED=false
# 신규 주문/견적의 기본 트랙. 'CONCIERGE' (KR 콘시어지) 또는 'SELF_SERVICE'.
# Phase 1-2 동안 고정. Phase 3에서 사용자/locale별 분기 도입.
NEXYFAB_TRACK_DEFAULT=CONCIERGE

# ── 법적 신고번호 (사이트 footer 표시) ───────────────────────────────────────
# 통신판매업 신고번호 — 이미 신고된 사업자. 시·군·구청 발급.
NEXT_PUBLIC_TELESALES_REG_NO=
# 통신판매중개업 신고번호 — M4(첫 결제 발생 시) 추가 신고 후 채움. 빈 값이면
# footer에 표시하지 않음 (지연 등록 패턴 — 메모리 nexyfab-gtm 참조).
NEXT_PUBLIC_TELESALES_BROKER_REG_NO=

# ── Tauri 데스크톱 설치 파일 (Phase-2 Week-4) ───────────────────────────────
# 각 OS별 설치 파일 URL. 빈 값이면 다운로드 버튼 placeholder 처리.
NEXT_PUBLIC_DESKTOP_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MACOS=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_LINUX=
NEXT_PUBLIC_DESKTOP_VERSION=0.1.0

# ── AI API ────────────────────────────────────────────────────────────────────
# Provider chain: comma-separated list, primary first then fallbacks.
# Defaults: AI_PROVIDER_PRIMARY=deepseek, AI_PROVIDER_FALLBACKS=anthropic,openai,local
AI_PROVIDER_PRIMARY=deepseek
AI_PROVIDER_FALLBACKS=anthropic,openai,local
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Anthropic Claude (preferred fallback). Default model: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OpenAI (secondary fallback). Default model: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp). Empty = disabled.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=llama3.1
QWEN_API_KEY=CHANGE_ME
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── AI prompt A/B variants ───────────────────────────────────────────────────
# Format: baseId:variantSuffix@fraction (comma-separated)
# Example: scad-intent-from-nl:tighter@0.3 routes 30% of users to the variant.
# Same userId always lands in the same bucket via FNV-1a hash.
AI_PROMPT_VARIANTS=
# Auto-disable strongly-regressing variants from the daily burn-in cron.
# Set to '1' once you trust the burn-in signal. OFF by default — manual review.
BURNIN_AUTO_DISABLE=

# ── Ops alert channels (used by cron jobs) ──────────────────────────────────
# Slack incoming webhook for variant burn-in / cost budget alerts.
SLACK_WEBHOOK_URL=
# Comma-separated admin emails (uses SMTP from MAIL_FROM).
OPS_ALERT_EMAIL=
# Daily AI spend ceiling in USD. Cron alerts when sum(prompt_call.costCents)/100 > limit.
COST_BUDGET_USD_DAILY=
# Per-user daily cap in USD. Once a single user's 24h prompt_call cost crosses
# this, AI calls return 402 until the rolling window drops. Empty = disabled.
COST_BUDGET_USD_PER_USER_DAILY=
# Approaching-limit warn fraction for the per-user budget (0..1). Default 0.8.
BUDGET_WARN_AT=
# Audit retention in days (used by /api/cron/audit-prune). Default 90.
AUDIT_RETENTION_DAYS=

# ── Real-time collaboration (CRDT) ───────────────────────────────────────────
# Set to '1' to enable Yjs CRDT for the feature tree (new behavior).
# Default OFF — legacy SSE feature_sync handles sync (last-write-wins).
NEXT_PUBLIC_NEXYFAB_CRDT=

# Wave 2 Phase 3 — Yjs WebSocket transport (occt-collab-worker on Cloudflare).
# Unset → local-only mode (BroadcastChannel + IndexedDB). Set to the wss URL
# of the deployed collab worker to enable remote peer sync.
# Example: wss://occt-collab-worker.<account>.workers.dev
NEXT_PUBLIC_OCCT_COLLAB_WS_URL=

# Wave 2 Phase 3 — collab debug hook for Playwright awareness-latency spec.
# Exposes window.__nexyfabAwareness; do NOT set in production bundles.
# Only set when running e2e/collab-awareness-latency.spec.ts against a build.
NEXT_PUBLIC_NEXYFAB_COLLAB_DEBUG=

# ── OpenSCAD 렌더 (AI CAD 파이프라인) ────────────────────────────────────────
# 프로덕션 Docker 이미지(Dockerfile)는 openscad + BOSL2 를 설치하고 OPENSCAD_BIN /
# OPENSCADPATH 를 이미 설정하므로 별도 지정 불필요. 아래는 로컬/비-Docker 개발용.
# OPENSCAD_BIN=/usr/bin/openscad           # openscad 실행 파일 경로 (미설정 시 PATH의 'openscad', Windows는 'openscad.com')
# OPENSCAD_USE_DOCKER=1                     # 호스트에 openscad 미설치 시 'docker run' 으로 렌더
# OPENSCAD_DOCKER_IMAGE=openscad/openscad:latest
# 대용량(>200KB) 비동기 렌더 잡을 멀티 인스턴스/재시작에도 보존하려면 REDIS_URL 설정 필요
# (미설정 시 in-memory 큐 — 단일 인스턴스에서만 안전)

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=CHANGE_ME
RECAPTCHA_SECRET_KEY=CHANGE_ME

# ── 외부 API ──────────────────────────────────────────────────────────────────
ALPHAVANTAGE_API_KEY=CHANGE_ME

# ── 파일 스토리지 (Cloudflare R2) ────────────────────────────────────────────
# R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=CHANGE_ME
S3_BUCKET=nexyfab
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# 퍼블릭 버킷 URL (선택 — 미설정 시 signed URL 사용)
# S3_PUBLIC_URL=https://pub-xxx.r2.dev

# ── CORS (외부 도메인 허용 시 콤마 구분) ────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://partner.example.com,https://app.example.com

# ── Cron ─────────────────────────────────────────────────────────────────────
# POST /api/jobs/process 호출 시 필요 (Railway/Vercel Cron)
# openssl rand -hex 32
CRON_SECRET=CHANGE_ME

# ── 모니터링 (Sentry) ─────────────────────────────────────────────────────────
# DSN은 Sentry 프로젝트 Settings → Client Keys에서 확인
NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME
SENTRY_DSN=CHANGE_ME
SENTRY_ORG=CHANGE_ME
SENTRY_PROJECT=nexyfab-web
SENTRY_AUTH_TOKEN=CHANGE_ME
# 브라우저 SDK: instrumentation-client.ts — 미설정·CHANGE_ME 이면 Sentry 미초기화
NEXT_PUBLIC_RELEASE=
# NEXT_PUBLIC_VERCEL_ENV=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.01

# ── Tauri 데스크톱 자동 업데이트 (선택) ───────────────────────────────────────
# npm run tauri:gen-keys 후 공개 키를 여기 넣고 CI에서만 주입 → scripts/tauri-updater-merge.mjs
# 기본 tauri.conf.json 은 updater.active=false (로컬 빌드용)
# TAURI_UPDATER_PUBKEY=

# ── Nexysys SSO ──────────────────────────────────────────────────────────────
NEXYSYS_AUTH_URL=https://auth.nexysys.com

# ── Railway Volume (DB 영속성) ───────────────────────────────────────────────
# Railway Volume을 /data에 마운트 후 설정 (Railway Dashboard → Add Volume → Mount: /data)
# DATA_ROOT=/data
# 또는 직접 경로 지정:
# NEXYFAB_DB_PATH=/data/nexyfab.db
