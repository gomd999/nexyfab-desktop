# ════════════════════════════════════════════════════════════════════════════
# NexyFab 환경변수 템플릿 — 이 파일을 .env.local로 복사 후 실제 값으로 교체
# 절대 실제 시크릿을 이 파일에 입력하지 마세요
# ════════════════════════════════════════════════════════════════════════════

# ── 앱 URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nexyfab.com
NEXT_PUBLIC_SITE_URL=https://nexyfab.com
# SSO/Auth server (Cloudflare Workers) — login/register/reset 리다이렉트 베이스
NEXT_PUBLIC_AUTH_URL=https://auth.nexysys.com
# 상위 Nexysys 포털 (헤더/푸터 링크, forgot-password 등)
NEXT_PUBLIC_NEXYSYS_URL=https://nexysys.com
# 한국어(/kr) 푸터의 「통합 사업자·법적 고지」 링크 목적지 (미설정 시 {NEXYSYS_URL}/kr/ )
# NEXT_PUBLIC_NEXYSYS_LEGAL_URL=https://nexysys.com/kr/legal

# 고객 문의 이메일 — 푸터 mailto·환불 안내 페이지 (미설정 시 nexyfab@nexysys.com)
# NEXT_PUBLIC_SUPPORT_EMAIL=nexyfab@nexysys.com

# ── 필수 보안 ───────────────────────────────────────────────────────────────
# 최소 32자 랜덤: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
SCAD_AGENT_SESSION_SECRET=CHANGE_ME_SEPARATE_MINIMUM_32_CHARACTERS
NEXYFAB_AGENT_APPROVAL_SECRET=CHANGE_ME_SEPARATE_MINIMUM_32_CHARACTERS
# bcrypt 해시: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_BOOTSTRAP_EMAILS=admin@example.com
ADMIN_SESSION_SECRET=CHANGE_ME_SEPARATE_MIN_32_CHARS
ADMIN_SECRET=CHANGE_ME_MIN_16_CHARS

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<USERNAME>:<PASSWORD>@<HOST>:5432/nexyfab?sslmode=require

# ── Redis (프로덕션 필수) ────────────────────────────────────────────────────
REDIS_URL=rediss://<USERNAME>:<PASSWORD>@<HOST>:<PORT>

# ── 이메일 발송 (Resend 권장, 또는 SMTP) ─────────────────────────────────────
# 방법 1: Resend (https://resend.com) — RESEND_API_KEY만 설정하면 즉시 동작
RESEND_API_KEY=re_CHANGE_ME

# 방법 2: SMTP 직접 연결 (Resend 없을 때 폴백)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nexyfab@nexysys.com
SMTP_PASS=CHANGE_ME

# NexyFab 공식 발신 주소 — 모든 이메일이 이 주소로 발송됨
SMTP_FROM="NexyFab" <nexyfab@nexysys.com>
NEXYFAB_FROM_EMAIL=nexyfab@nexysys.com

# 관리자 수신 주소
ADMIN_EMAIL=nexyfab@nexysys.com
NEXYFAB_ADMIN_EMAIL=nexyfab@nexysys.com
# AI 공급자/모델 장애 전용 수신자(콤마 구분). 비우면 활성 관리자 이메일과
# ADMIN_EMAIL/NEXYFAB_ADMIN_EMAIL을 사용합니다. 같은 모델은 최초 1회 후 24시간 억제됩니다.
AI_FAILURE_ALERT_EMAIL=
# 주문/문의 알림 수신자 (콤마 구분)
SEND_MAIL_RECIPIENTS=nexyfab@nexysys.com

# ── Stripe (글로벌 결제 — 카드) ──────────────────────────────────────────────
# Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
# Stripe Dashboard → Developers → Webhooks → 엔드포인트 → Signing secret
# 웹훅 URL: https://nexyfab.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Airwallex (글로벌 결제) ───────────────────────────────────────────────────
AIRWALLEX_CLIENT_ID=CHANGE_ME
AIRWALLEX_API_KEY=CHANGE_ME
AIRWALLEX_WEBHOOK_SECRET=CHANGE_ME
# 환경: "prod" = 운영, 그 외 = sandbox (demo)
AIRWALLEX_ENV=demo
# 국가별 기본 결제수단 오버라이드 (콤마 구분 awMethod 코드, 선택)
# AIRWALLEX_DEFAULT_PM=card,wechatpay
# 플랜별 Airwallex 가격 오버라이드 (USD 기준, 미설정 시 country-pricing.ts 기본값 사용)
# AIRWALLEX_PLAN_PRO_USD=29
# AIRWALLEX_PLAN_TEAM_USD=79
# AIRWALLEX_PLAN_ENTERPRISE_USD=299

# ── Toss Payments ────────────────────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=CHANGE_ME
TOSS_SECRET_KEY=CHANGE_ME
# 웹훅 서명 검증용 (Toss Payments 대시보드 → 웹훅 → 서명 키) — 미설정 시 웹훅 거부
TOSS_WEBHOOK_SECRET=CHANGE_ME

# ── Phase-1 Launch Gates (fake-door) ─────────────────────────────────────────
# 자동 에스크로 결제 흐름 게이트. 통신판매중개업 신고 + Toss 에스크로 옵션 활성
# 완료 후 'true'로 전환. false면 결제 시도 시 '예약' 상태로 잡고 founder 알림.
# Global charge collection switch. Fail-closed: only the exact value `true`
# enables checkout, confirmation, subscription upgrades and automatic retries.
# Keep false for the official no-payment launch.
NEXYFAB_PAYMENTS_ENABLED=false
NEXYFAB_ESCROW_ENABLED=false
# 신규 주문/견적의 기본 트랙. 'CONCIERGE' (KR 콘시어지) 또는 'SELF_SERVICE'.
# Phase 1-2 동안 고정. Phase 3에서 사용자/locale별 분기 도입.
NEXYFAB_TRACK_DEFAULT=CONCIERGE

# ── 법적 신고번호 (사이트 footer 표시) ───────────────────────────────────────
# 통신판매업 신고번호 — 이미 신고된 사업자. 시·군·구청 발급.
NEXT_PUBLIC_TELESALES_REG_NO=
# 통신판매중개업 신고번호 — M4(첫 결제 발생 시) 추가 신고 후 채움. 빈 값이면
# footer에 표시하지 않음 (지연 등록 패턴 — 메모리 nexyfab-gtm 참조).
NEXT_PUBLIC_TELESALES_BROKER_REG_NO=

# ── Tauri 데스크톱 설치 파일 (Phase-2 Week-4) ───────────────────────────────
# 각 OS별 설치 파일 URL. 빈 값이면 다운로드 버튼 placeholder 처리.
NEXT_PUBLIC_DESKTOP_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MACOS=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_LINUX=
NEXT_PUBLIC_DESKTOP_VERSION=0.1.0

# ── AI API ────────────────────────────────────────────────────────────────────
# Provider chain: comma-separated list, primary first then fallbacks.
# Code defaults (src/lib/ai/index.ts): PRIMARY=deepseek, FALLBACKS=gemini,openai,local
#
# ⚠ 260803 — 여기 fallbacks 에 `anthropic` 이 적혀 있었는데 **코드는 의도적으로 뺀다**
#   ("avoid surprise Opus spend on provider outages"). 이 파일을 그대로 .env 로 복사하면
#   코드가 피하려던 체인이 그대로 켜졌다. 코드 기본값과 일치시킨다.
#   anthropic 은 여전히 REGISTRY 에 있으므로 req.provider 나 이 변수로 명시하면 쓸 수 있다.
AI_PROVIDER_PRIMARY=deepseek
AI_PROVIDER_FALLBACKS=gemini,openai,local
# Stable NexyFab model slugs can be remapped from Admin > Settings without
# exposing provider IDs to clients. These are deployment defaults.
AI_MODEL_GPT_LUNA=gpt-5.6-luna
AI_MODEL_QWEN_3_7_PLUS=qwen3.7-plus
AI_MODEL_QWEN_3_7_MAX=qwen3.7-max
AI_MODEL_DEEPSEEK_PRO=deepseek-v4-pro
AI_MODEL_QWEN_3_8_MAX=qwen3.8-max-preview
AI_MODEL_GPT_TERRA=gpt-5.6-terra
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Anthropic Claude (명시 요청 시에만 — 기본 체인에서는 제외). Default model: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OpenAI (secondary fallback). Default model: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp). Empty = disabled.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=llama3.1
QWEN_API_KEY=CHANGE_ME
# The API key and endpoint MUST be from the same DashScope region.
# China:     https://dashscope.aliyuncs.com/compatible-mode/v1
# Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── AI prompt A/B variants ───────────────────────────────────────────────────
# Format: baseId:variantSuffix@fraction (comma-separated)
# Example: scad-intent-from-nl:tighter@0.3 routes 30% of users to the variant.
# Same userId always lands in the same bucket via FNV-1a hash.
AI_PROMPT_VARIANTS=
# Auto-disable strongly-regressing variants from the daily burn-in cron.
# Set to '1' once you trust the burn-in signal. OFF by default — manual review.
BURNIN_AUTO_DISABLE=

# ── Ops alert channels (used by cron jobs) ──────────────────────────────────
# Slack incoming webhook for variant burn-in / cost budget alerts.
SLACK_WEBHOOK_URL=
# Comma-separated admin emails (uses SMTP from MAIL_FROM).
OPS_ALERT_EMAIL=
# Daily AI spend ceiling in USD. Cron alerts when sum(prompt_call.costCents)/100 > limit.
COST_BUDGET_USD_DAILY=
# Per-user daily cap in USD. Once a single user's 24h prompt_call cost crosses
# this, AI calls return 402 until the rolling window drops. Empty = disabled.
COST_BUDGET_USD_PER_USER_DAILY=
# Approaching-limit warn fraction for the per-user budget (0..1). Default 0.8.
BUDGET_WARN_AT=
# Audit retention in days (used by /api/cron/audit-prune). Default 90.
AUDIT_RETENTION_DAYS=

# ── Real-time collaboration (CRDT) ───────────────────────────────────────────
# Set to '1' to enable Yjs CRDT for the feature tree (new behavior).
# Default OFF — legacy SSE feature_sync handles sync (last-write-wins).
NEXT_PUBLIC_NEXYFAB_CRDT=

# Wave 2 Phase 3 — Yjs WebSocket transport (occt-collab-worker on Cloudflare).
# Unset → local-only mode (BroadcastChannel + IndexedDB). Set to the wss URL
# of the deployed collab worker to enable remote peer sync.
# Example: wss://occt-collab-worker.<account>.workers.dev
NEXT_PUBLIC_OCCT_COLLAB_WS_URL=

# Wave 2 Phase 3 — collab debug hook for Playwright awareness-latency spec.
# Exposes window.__nexyfabAwareness; do NOT set in production bundles.
# Only set when running e2e/collab-awareness-latency.spec.ts against a build.
NEXT_PUBLIC_NEXYFAB_COLLAB_DEBUG=

# ── 격리 CAD runtime (AI CAD 파이프라인) ────────────────────────────────────
# 프로덕션 웹 이미지는 native CAD 바이너리를 포함하지 않습니다. 아래 두 경계를
# 반드시 켜고 web/worker 양쪽에 같은 REDIS_URL을 연결합니다.
OPENSCAD_EXTERNAL_WORKER=1
CAD_RUNTIME_EXTERNAL_WORKER=1
# web 빌드는 kr/en만 사전 생성하고 ja/cn/es/ar은 첫 요청에 생성·캐시합니다.
NEXYFAB_PRERENDER_LOCALES=kr,en
# 아래 항목은 로컬/비-Docker 개발에서만 사용합니다.
# OPENSCAD_BIN=/usr/bin/openscad           # openscad 실행 파일 경로 (미설정 시 PATH의 'openscad', Windows는 'openscad.com')
# OPENSCAD_USE_DOCKER=1                     # 호스트에 openscad 미설치 시 'docker run' 으로 렌더
# OPENSCAD_DOCKER_IMAGE=openscad/openscad:latest

# worker 이미지는 OpenSCAD+BOSL2, Gmsh, checksum 고정 Radiance를 소유합니다.
# 웹 서비스에 OPENSCAD_BIN/GMSH_BIN/RADIANCE_* 경로를 설정하지 않습니다.

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=CHANGE_ME
RECAPTCHA_SECRET_KEY=CHANGE_ME
# Comma-separated production hosts, e.g. nexyfab.com,www.nexyfab.com
RECAPTCHA_ALLOWED_HOSTNAMES=
RECAPTCHA_MIN_SCORE=0.5

# ── 외부 API ──────────────────────────────────────────────────────────────────
ALPHAVANTAGE_API_KEY=CHANGE_ME

# ── 파일 스토리지 (Cloudflare R2) ────────────────────────────────────────────
# R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=CHANGE_ME
S3_BUCKET=nexyfab
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# 퍼블릭 버킷 URL (선택 — 미설정 시 signed URL 사용)
# S3_PUBLIC_URL=https://pub-xxx.r2.dev

# OCCT STEP worker. For >50 MB files the worker must accept sourceUrl +
# sourceBytes and fetch the five-minute private signed URL itself.
# BREP_WORKER_URL=https://cad-worker.internal
# BREP_WORKER_TIMEOUT_MS=120000
# BREP_MAX_QUEUE_DEPTH=200

# ── CORS (외부 도메인 허용 시 콤마 구분) ────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://partner.example.com,https://app.example.com

# ── Cron ─────────────────────────────────────────────────────────────────────
# POST /api/jobs/process 호출 시 필요 (Railway/Vercel Cron)
# openssl rand -hex 32
# Closed-beta compatibility gate: shadow (default), enforce, or off.
# shadow records would-block decisions without changing existing responses.
SECURITY_GATE_MODE=shadow

CRON_SECRET=CHANGE_ME

# ── 모니터링 (Sentry) ─────────────────────────────────────────────────────────
# DSN은 Sentry 프로젝트 Settings → Client Keys에서 확인
NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME
SENTRY_DSN=CHANGE_ME
SENTRY_ORG=CHANGE_ME
SENTRY_PROJECT=nexyfab-web
SENTRY_AUTH_TOKEN=CHANGE_ME
# 브라우저 SDK: instrumentation-client.ts — 미설정·CHANGE_ME 이면 Sentry 미초기화
NEXT_PUBLIC_RELEASE=
# NEXT_PUBLIC_VERCEL_ENV=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.01

# ── Tauri 데스크톱 자동 업데이트 (선택) ───────────────────────────────────────
# npm run tauri:gen-keys 후 공개 키를 여기 넣고 CI에서만 주입 → scripts/tauri-updater-merge.mjs
# 기본 tauri.conf.json 은 updater.active=false (로컬 빌드용)
# TAURI_UPDATER_PUBKEY=

# ── Nexysys SSO ──────────────────────────────────────────────────────────────
NEXYSYS_AUTH_URL=https://auth.nexysys.com

# ── Railway Volume (DB 영속성) ───────────────────────────────────────────────
# Railway Volume을 /data에 마운트 후 설정 (Railway Dashboard → Add Volume → Mount: /data)
# DATA_ROOT=/data
# 또는 직접 경로 지정:
# NEXYFAB_DB_PATH=/data/nexyfab.db

# Native CAD worker executables (optional; licensed isolated hosts)
# Each command must implement --request <json> --source <cad> --output <json>.
# Local/reference corpus root used only by evidence scripts; never expose it through an API.
# NEXYFAB_REFERENCE_CORPUS_ROOT=D:\nexyfab-reference-corpus
# NEXYFAB_REFERENCE_IR_ROOT=D:\nexyfab-reference-corpus\result\ir
# NEXYFAB_CAD_MANUALS_ROOT=D:\nexyfab-manuals
# NEXYFAB_SOLIDWORKS_WORKER_COMMAND=C:\\nexyfab-workers\\solidworks-worker.exe
# NEXYFAB_INVENTOR_WORKER_COMMAND=C:\\nexyfab-workers\\inventor-worker.exe
# NEXYFAB_CATIA_WORKER_COMMAND=C:\\nexyfab-workers\\catia-worker.exe
# NEXYFAB_CREO_WORKER_COMMAND=C:\\nexyfab-workers\\creo-worker.exe
# NEXYFAB_PARASOLID_WORKER_COMMAND=C:\\nexyfab-workers\\parasolid-worker.exe
# NEXYFAB_DWG_WORKER_COMMAND=C:\\nexyfab-workers\\dwg-worker.exe
# NEXYFAB_REVIT_WORKER_COMMAND=C:\\nexyfab-workers\\revit-worker.exe
# Absolute, operator-controlled outputs from the health/canary evidence scripts.
# These are read-only status inputs; command paths and license details are never returned by the admin API.
# NEXYFAB_NATIVE_WORKER_HEALTH_EVIDENCE=C:\\nexyfab-evidence\\native-worker-health-probe.json
# NEXYFAB_NATIVE_WORKER_CANARY_EVIDENCE=C:\\nexyfab-evidence\\native-worker-canary-gate.json
# JSON map of approved reviewer IDs to Ed25519 public keys (deployment config).
# Two different trusted IDs must sign; never store private keys here.
# NEXYFAB_CAD_REVIEWER_KEYS={"domain-reviewer-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["domain-reviewer"]},"independent-reviewer-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["independent-reviewer"]}}
# Mechanical direct-design artifact verifier registry. Require three distinct
# Ed25519 identities with role-specific public-key authorization; private keys
# remain in isolated verifier services and must never be stored here.
# NEXYFAB_MECHANICAL_DESIGN_VERIFIER_KEYS={"step-verifier-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["mechanical-step-verifier"]},"drawing-verifier-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["mechanical-drawing-verifier"]},"bom-verifier-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["mechanical-bom-verifier"]}}
# Blind product-challenge reviewer registry; private reviewer keys stay outside
# the application/runtime environment.
# NEXYFAB_BLIND_REVIEWER_KEYS={"blind-reviewer-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["mechanical-blind-reviewer"]}}
# Robot Verified Systems evidence trust. Keep all private keys in a deployment
# secret manager or isolated signing service; never commit real key material.
# NEXYFAB_ROBOT_EXACT_CAD_SIGNER_KEYS={"kernel-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}}
# NEXYFAB_ROBOT_MANUFACTURING_REVIEWER_KEYS={"manufacturing-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}}
# NEXYFAB_ROBOT_PHYSICAL_VALIDATION_KEYS={"operator-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["test-operator"]},"physical-reviewer-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----","roles":["independent-reviewer"]}}
# Audit API signer (private deployment secret) and corresponding final-review registry.
# NEXYFAB_ROBOT_VERIFIED_AUDIT_SIGNER={"auditorId":"verified-auditor-01","privateKey":"PKCS8_PEM_FROM_SECRET_MANAGER"}
# NEXYFAB_ROBOT_VERIFIED_AUDITOR_KEYS={"verified-auditor-01":{"publicKey":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}}

# Commercial release evidence (store real values only in deployment secrets)
NEXYFAB_COMMERCIAL_MODE=0
NEXYFAB_REQUIRE_SIGNED_GENERATION_EVIDENCE=0
# 32+ random bytes. Required when NEXYFAB_COMMERCIAL_MODE=1.
GENERATION_EVIDENCE_SIGNING_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=CHANGE_ME_STABLE_RANDOM_KEY
CRON_SECRET=CHANGE_ME_MIN_32_CHARS
# Dedicated exact-clash worker boundary; never reuse ADMIN_SECRET/CRON_SECRET.
NEXYFAB_SPATIAL_CAD_WORKER_SECRET=CHANGE_ME_SEPARATE_MIN_32_CHARS
# JSON map: worker id -> approved worker image/config SHA-256.
NEXYFAB_SPATIAL_CAD_WORKER_IDENTITIES={}
# Comma-separated approved OCCT kernel stack identity SHA-256 values.
NEXYFAB_SPATIAL_CAD_KERNEL_IDENTITIES=
# Cloudflare Queue/Workflow -> Core authorization boundary.
NEXYFAB_JOB_ORCHESTRATOR_CORE_SECRET=CHANGE_ME_SEPARATE_MIN_32_CHARS
NEXYFAB_JOB_AUTHORIZATION_SECRET=CHANGE_ME_SEPARATE_MIN_32_CHARS
# NexyFab -> NEXYCAD project handoff. Generate a dedicated Ed25519 key pair;
# keep the PKCS8 private PEM base64 only in NexyFab secrets and publish only
# the matching public PEM base64 to NEXYCAD Core.
NEXYCAD_STUDIO_URL=https://cad-preview.nexyfab.com/
# Build-time UI flag. Enable only in the same deployment that has the server
# signing secret and whose NEXYCAD Core trusts the matching public key.
NEXT_PUBLIC_NEXYCAD_HANDOFF_ENABLED=0
NEXYCAD_HANDOFF_ISSUER=https://nexyfab.com
NEXYCAD_HANDOFF_AUDIENCE=nexycad-commercial
NEXYCAD_HANDOFF_KEY_ID=
NEXYCAD_HANDOFF_PRIVATE_KEY_PEM_BASE64=
# JSON map of deploy unit -> approved container image/config SHA-256.
NEXYFAB_CAD_WORKER_IDENTITIES={}
# Comma-separated approved OCCT/interop kernel stack identity SHA-256 values.
NEXYFAB_CAD_KERNEL_IDENTITIES=
# Each compute container receives its own 32+ character ingress secret and
# immutable build/kernel identities from the deployment secret manager.
NEXYFAB_COMPUTE_SHARED_SECRET=CHANGE_ME_SEPARATE_MIN_32_CHARS
NEXYFAB_WORKER_IDENTITY_SHA256=
NEXYFAB_KERNEL_IDENTITY_SHA256=
NEXYFAB_WORKER_BUILD_ID=
# Railway fallback only. Keep targets unset until their staging health and
